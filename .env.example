# Banco de dados (PostgreSQL)
DB_USER=postgres
DB_PASS=postgres
DB_HOST=host.docker.internal
DB_NAME=biblia
APP_PORT=8087

# Busca vetorial (pgvector)
HNSW_EF_SEARCH=64

# Embeddings (Qwen GGUF) - escolha um provedor
# Opção A: Ollama
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
EMBEDDING_MODEL=qwen3-embedding-4b-gguf-q8_0

# Opção B: llama.cpp (endpoint de embeddings)
# EMBEDDING_PROVIDER=llama_cpp
# LLAMA_CPP_EMBED_URL=http://llama-cpp:8080/v1/embeddings
# EMBEDDING_MODEL=qwen3-embedding-4b-gguf-q8_0
